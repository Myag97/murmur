{
  "manifest_version": 3,
  "name": "Murmur Reader",
  "version": "0.2.0",
  "description": "Reads web pages, PDFs, Word files and Google Docs aloud in a natural voice that runs on your own computer. Free, private, no limits.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "contextMenus"],
  "optional_permissions": ["identity"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Murmur: read this page (right-click for settings)" },
  "commands": {
    "toggle-play": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Read this page / pause / resume"
    },
    "next-sentence": {
      "suggested_key": { "default": "Alt+Shift+Period" },
      "description": "Next sentence"
    },
    "prev-sentence": {
      "suggested_key": { "default": "Alt+Shift+Comma" },
      "description": "Previous sentence"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
